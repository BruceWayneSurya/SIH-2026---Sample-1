# LOCAL DEVELOPMENT: keep DATABASE_URL blank to use ./data/app.db.
# Local absolute/relative filenames and file:// URLs remain supported.
DATABASE_URL=

# VERCEL: a permanent hosted SQLite/libSQL database is required.
# Set these in Vercel Project Settings > Environment Variables, not client code:
# DATABASE_URL=libsql://your-database-your-organization.turso.io
# DATABASE_AUTH_TOKEN=<database access token>
# TURSO_DATABASE_URL / TURSO_AUTH_TOKEN are also supported as aliases.
# Choose a libSQL database, not a turso:// database using the newer engine.
DATABASE_AUTH_TOKEN=

# Use a randomly generated value of at least 32 characters on Vercel.
# The public demo/default/placeholder secret is rejected on Vercel.
SESSION_SECRET=replace-with-a-long-random-secret-in-production

# AI / Groq — server-side ONLY; never prefix secrets with NEXT_PUBLIC_.
# Leave blank to disable AI without affecting the rest of the portal.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
