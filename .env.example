# Copy to .env and adjust for your environment.
# SQLite file used by the app, migrations and the demo seed.
# Can be an absolute path, a relative path, or a file:// URL.
# Leave unset or blank to default to ./data/app.db inside the project.
DATABASE_URL=

# Secret used to sign session cookies (set to a long random value in production).
SESSION_SECRET=vidyasetu-sih-demo-secret

# ----------------------------------------------------------------
# AI / Groq configuration (server-side ONLY)
# ----------------------------------------------------------------
# Get your key at https://console.groq.com/keys
# Keep the real key in your gitignored .env; never use NEXT_PUBLIC_ for secrets.
# Browser requests go through /api/ai/chat, not directly to Groq.
# Leave blank to disable AI without affecting notes, previews, quizzes or voting.
GROQ_API_KEY=

# The configured model is passed to Groq unchanged.
# When blank/unset the server falls back to llama-3.3-70b-versatile.
GROQ_MODEL=openai/gpt-oss-120b
